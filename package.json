{
  "name": "team-task-manager",
  "version": "1.0.0",
  "description": "Full-stack Team Task Manager with React, Express, Prisma, authentication, projects, teams, tasks, dashboard, and role-based access control.",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "nodemon server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "prisma generate && vite build",
    "start": "node server/index.js",
    "start:railway": "npm run db:push && node server/index.js",
    "postinstall": "prisma generate",
    "db:push": "node scripts/ensure-sqlite-file.js && prisma db push",
    "db:seed": "node prisma/seed.js",
    "lint": "eslint ."
  },
  "keywords": [
    "react",
    "express",
    "prisma",
    "tasks",
    "railway"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "morgan": "^1.10.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "nodemon": "^3.1.9",
    "prisma": "^5.22.0",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
